<Window x:Class="ARISHrms.Views.AddAdvanceDateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Advance Date" Height="300" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Advance handed over" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock x:Name="TxtEmployee" Foreground="#475569" Margin="0,2,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="38"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Date taken:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <DatePicker x:Name="DpDate" Grid.Row="0" Grid.Column="1" Height="28" Width="150" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="1" Text="Amount (₹):" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal">
                <TextBox x:Name="TxtAmount" Width="120" Height="28" VerticalContentAlignment="Center" Padding="5,0"/>
                <TextBlock Text="(optional)" Foreground="#94A3B8" FontStyle="Italic" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Note:" VerticalAlignment="Center" FontWeight="SemiBold"/>
            <TextBox x:Name="TxtNote" Grid.Row="2" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="5,0"
                     ToolTip="e.g. Extra advance for wedding"/>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="💾 Save" Click="BtnSave_Click" Width="100" Height="32" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,10,0" IsDefault="True"/>
            <Button Content="Cancel" Click="BtnCancel_Click" Width="90" Height="32" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
