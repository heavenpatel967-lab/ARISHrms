<UserControl x:Class="ARISHrms.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Dashboard" FontSize="28" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>

        <!-- KPI Cards -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total Employees Card -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Employees" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtTotalEmployees" Text="0" FontSize="24" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
            </Border>

            <!-- Active Loans Card -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Active Loans" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtActiveLoanCount" Text="0" FontSize="24" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
            </Border>

            <!-- Pending Advances Card -->
            <Border Grid.Column="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Pending Advances" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtPendingAdvances" Text="0" FontSize="24" FontWeight="Bold" Foreground="#EA580C"/>
                </StackPanel>
            </Border>

            <!-- On Leave Today Card -->
            <Border Grid.Column="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="On Leave Today" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtOnLeaveToday" Text="0" FontSize="24" FontWeight="Bold" Foreground="#7C3AED"/>
                </StackPanel>
            </Border>

            <!-- Docs Expiring Card -->
            <Border Grid.Column="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Docs Expiring Soon" Foreground="#64748B" FontSize="12" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtDocsExpiring" Text="0" FontSize="24" FontWeight="Bold" Foreground="#F59E0B"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Summary Stats -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Loans Summary -->
            <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Loans Summary" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Total Amount" Foreground="#64748B" FontSize="12"/>
                            <TextBlock x:Name="TxtTotalLoanAmount" Text="₹ 0" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="In Arrears" Foreground="#64748B" FontSize="12"/>
                            <TextBlock x:Name="TxtLoansInArrears" Text="0" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Attendance Summary -->
            <Border Grid.Column="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="20">
                <StackPanel>
                    <TextBlock Text="Attendance Summary" FontSize="16" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="Today's Punches" Foreground="#64748B" FontSize="12"/>
                            <TextBlock x:Name="TxtTodayPunches" Text="0" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Exceptions" Foreground="#64748B" FontSize="12"/>
                            <TextBlock x:Name="TxtTodayExceptions" Text="0" FontSize="16" FontWeight="Bold" Foreground="#F59E0B"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
