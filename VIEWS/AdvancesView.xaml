<UserControl x:Class="ARISHrms.Views.AdvancesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ARISHrms.Views"
             Background="#F8FAFC">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Employee Selection -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="False">
            <TextBlock Text="Monthly Advance Ledger" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="🔍 Card No / Name:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtEmpSearch" Width="150" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,6,0"
                         ToolTip="Type a card number, employee code or name. Enter = pick the best match, Down arrow = open the list, Esc = clear."/>
                <TextBlock x:Name="TxtSearchHint" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" MinWidth="95" Margin="0,0,14,0"/>
                <TextBlock Text="Select Employee:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbSelectEmployee" Width="330" Height="32" VerticalContentAlignment="Center" 
                          DisplayMemberPath="DisplayName" SelectedValuePath="EmpCode" SelectionChanged="CmbSelectEmployee_SelectionChanged"/>
            </WrapPanel>
        </DockPanel>

        <!-- Summary KPI Cards -->
        <Border Grid.Row="1" Background="#2563EB" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Advances Taken -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Advances Taken" Foreground="#DBEAFE" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalAdvances" Text="₹ 0.00" Foreground="White" FontWeight="Bold" FontSize="24" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Set Monthly Limit -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Set Monthly Limit (₹)" Foreground="#DBEAFE" FontWeight="SemiBold" FontSize="12"/>
                    <TextBox x:Name="TxtMonthlyLimit" Text="5000" TextChanged="TxtMonthlyLimit_TextChanged" Width="100" Height="28" HorizontalAlignment="Left" Margin="0,5,0,0" 
                             Background="Transparent" Foreground="#FCD34D" FontWeight="Bold" FontSize="18" BorderThickness="0,0,0,2" BorderBrush="#FCD34D"/>
                </StackPanel>

                <!-- Advance Health -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Advance Health (Limit)" Foreground="#DBEAFE" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtHealth" Text="0 / 0 Safe" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Last 6 Months Trend -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Last 6 Months Trend" Foreground="#DBEAFE" FontWeight="SemiBold" FontSize="12"/>
                    <StackPanel x:Name="TrendDotsContainer" Orientation="Horizontal" Margin="0,10,0,0" Height="15"/>
                </StackPanel>

                <!-- Advance taken (ticked) - last 6 months -->
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Advance Taken (last 6 months)" Foreground="#DBEAFE" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtTakenHealth" Text="0 / 6 Months" Foreground="White" FontWeight="Bold" FontSize="18" Margin="0,5,0,0"/>
                    <StackPanel x:Name="TakenDotsContainer" Orientation="Horizontal" Margin="0,4,0,0" Height="15"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Monthly Breakdown Grid + Track Record -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <GroupBox Grid.Column="0" Header="Monthly Advances Breakdown  (tick = advance handed over, pick the real date)" FontWeight="Bold" Foreground="#0F172A">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,4,0,6" LastChildFill="False">
                        <TextBlock x:Name="TxtTakenSummary" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#475569" FontWeight="Normal"/>
                        <Button DockPanel.Dock="Right" Content="➕ Add advance date" Click="BtnAddAdvanceDate_Click" Width="150" Height="28"
                                Background="#0EA5E9" Foreground="White" FontWeight="Bold"
                                ToolTip="Record an advance given on any date - also extra advances outside the normal advance day"/>
                    </DockPanel>

                    <DataGrid x:Name="AdvanceGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                              Background="White" RowHeight="34" AlternatingRowBackground="#F8FAFC"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- Status Dot Column -->
                            <DataGridTemplateColumn Header="Status" Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="12" Height="12" Fill="{Binding StatusColor}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Month / Year" Binding="{Binding MonthYear}" Width="110"/>
                            <DataGridTextColumn Header="Advance Amount" Binding="{Binding AmountDisplay}" Width="130">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#10B981"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <!-- Taken tick -->
                            <DataGridTemplateColumn Header="Taken ✔" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsTaken, Mode=OneWay}" Click="ChkTaken_Click"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  ToolTip="Tick when the advance was actually handed over"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Real date it was taken -->
                            <DataGridTemplateColumn Header="Taken On (full date)" Width="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DatePicker SelectedDate="{Binding TakenDate, Mode=OneWay}" SelectedDateChanged="DpTakenDate_Changed"
                                                    IsEnabled="{Binding CanEditDate}" Height="26" VerticalAlignment="Center" BorderThickness="0"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#64748B"/>
                                        <Setter Property="FontWeight" Value="Normal"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </GroupBox>

            <local:TrackRecordPanel x:Name="TrackRecord" Grid.Column="2"/>
        </Grid>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3" Margin="0,15,0,0" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                <TextBlock x:Name="TxtLifetimeAdvance" Text="Total Lifetime Advance: ₹ 0.00" FontWeight="Bold" Foreground="#475569"/>
                <TextBlock x:Name="TxtInfo" Text="" Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="📥 Import Limits CSV" Click="BtnImportLimits_Click" Width="150" Height="34" Background="#8B5CF6" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="📊 Export to Excel" Click="BtnExportExcel_Click" Width="130" Height="34" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="🖨️ Print / PDF (all pages)" Click="BtnSavePdf_Click" Width="175" Height="34" Background="#EF4444" Foreground="White" FontWeight="Bold"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>