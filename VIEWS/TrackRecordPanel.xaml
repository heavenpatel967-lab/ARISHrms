<UserControl x:Class="ARISHrms.Views.TrackRecordPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ARISHrms.Views">
    <Border Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title + verdict -->
            <DockPanel Grid.Row="0" LastChildFill="False">
                <TextBlock Text="TRACK RECORD" FontWeight="Bold" FontSize="14" Foreground="#0F172A" VerticalAlignment="Center"/>
                <Border x:Name="VerdictBadge" DockPanel.Dock="Right" CornerRadius="10" Padding="10,3" Background="#64748B">
                    <TextBlock x:Name="TxtVerdict" Text="No record yet" Foreground="White" FontWeight="Bold" FontSize="12"/>
                </Border>
            </DockPanel>
            <TextBlock Grid.Row="1" x:Name="TxtVerdictDetail" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,8"/>

            <!-- Village leave record -->
            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" Padding="8" Margin="0,0,0,8">
                <StackPanel>
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Village leave record:" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                        <TextBlock x:Name="TxtLeave" DockPanel.Dock="Right" FontWeight="Bold" FontSize="12" Foreground="#0F172A"/>
                    </DockPanel>
                    <ItemsControl x:Name="IcLeaveDots" Margin="0,5,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Ellipse Width="11" Height="11" Fill="{Binding Color}" Margin="0,0,3,0" ToolTip="{Binding Month}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="green = back on time   yellow = up to 7 days late   red = more than 7 days late" Foreground="#94A3B8" FontSize="10" Margin="0,4,0,0"/>

                    <local:MonthlyLeaveTable x:Name="LeaveMonths" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <!-- Remarks list -->
            <ListBox Grid.Row="3" x:Name="LstRemarks" BorderThickness="0" Background="Transparent" MinHeight="60"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding Background}" BorderBrush="{Binding Color}" BorderThickness="3,0,0,0" CornerRadius="3" Padding="8,5">
                            <DockPanel LastChildFill="True">
                                <Button DockPanel.Dock="Right" Content="✕" Click="BtnDeleteRemark_Click" Tag="{Binding Id}" ToolTip="Delete this remark"
                                        Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" Padding="4,0" VerticalAlignment="Top"/>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding KindLabel}" Foreground="{Binding Color}" FontWeight="Bold" FontSize="11" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding DateDisplay}" Foreground="#475569" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#0F172A" FontSize="12" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="3" x:Name="TxtNoRemarks" Text="No remarks yet." Foreground="#94A3B8" FontStyle="Italic" Margin="2,6,0,0"/>

            <!-- Add remark -->
            <Border x:Name="AddRemarkBox" Grid.Row="4" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <DatePicker x:Name="DpRemarkDate" Width="125" Height="28" Margin="0,0,10,0" ToolTip="Date of the remark"/>
                        <RadioButton x:Name="RbGood" Content="GOOD" IsChecked="True" GroupName="RemarkKind" Foreground="#27AE60" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <RadioButton x:Name="RbBad" Content="BAD" GroupName="RemarkKind" Foreground="#E74C3C" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DockPanel LastChildFill="True">
                        <Button DockPanel.Dock="Right" Content="➕ Add Remark" Click="BtnAddRemark_Click" Width="110" Height="30" Margin="8,0,0,0"
                                Background="#2563EB" Foreground="White" FontWeight="Bold"/>
                        <TextBox x:Name="TxtRemark" Height="30" VerticalContentAlignment="Center" Padding="6,0" ToolTip="e.g. Returned advance on time / Took advance and left for 20 days"/>
                    </DockPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
