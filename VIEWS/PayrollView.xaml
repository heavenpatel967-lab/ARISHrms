<UserControl x:Class="ARISHrms.Views.PayrollView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Salary Slips &amp; Payroll" FontSize="20" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

        <!-- Controls -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="Month:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <DatePicker x:Name="DtpMonth" SelectedDateChanged="DtpMonth_SelectedDateChanged" Width="150" Margin="0,0,20,0"/>
            
            <Button Content="Generate Payroll" Click="BtnGeneratePayroll_Click" Width="140" Height="34" Background="#3B82F6" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="Export Excel" Click="BtnExportExcel_Click" Width="140" Height="34" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="Export PDF" Click="BtnExportPdf_Click" Width="140" Height="34" Background="#F59E0B" Foreground="White" FontWeight="Bold"/>
        </StackPanel>

        <!-- Summary -->
        <Border Grid.Row="2" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Employees" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtEmployeeCount" Text="0" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total Gross" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalGross" Text="₹ 0" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Total Deductions" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalDeductions" Text="₹ 0" FontSize="18" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
                
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Total Net" Foreground="#64748B" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalNet" Text="₹ 0" FontSize="18" FontWeight="Bold" Foreground="#10B981"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Payroll Register Grid -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6">
            <DataGrid x:Name="PayrollGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                     Background="Transparent" RowHeight="32" AlternatingRowBackground="#F8FAFC"
                     HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Employee Code" Binding="{Binding EmpCode}" Width="120"/>
                    <DataGridTextColumn Header="Basic Salary" Binding="{Binding BasicSalary, StringFormat=₹ {0:N0}}" Width="130"/>
                    <DataGridTextColumn Header="Gross" Binding="{Binding Gross, StringFormat=₹ {0:N0}}" Width="120"/>
                    <DataGridTextColumn Header="Loan EMI" Binding="{Binding LoanEMI, StringFormat=₹ {0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Advance" Binding="{Binding AdvanceRecovery, StringFormat=₹ {0:N0}}" Width="110"/>
                    <DataGridTextColumn Header="Late Penalty" Binding="{Binding LatePenalty, StringFormat=₹ {0:N0}}" Width="120"/>
                    <DataGridTextColumn Header="PF" Binding="{Binding PF, StringFormat=₹ {0:N0}}" Width="100"/>
                    <DataGridTextColumn Header="Total Deduction" Binding="{Binding TotalDeduction, StringFormat=₹ {0:N0}}" Width="140"/>
                    <DataGridTextColumn Header="Net Salary" Binding="{Binding NetSalary, StringFormat=₹ {0:N0}}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer -->
        <TextBlock Grid.Row="4" x:Name="TxtInfo" Text="Select a month and click 'Generate Payroll' to generate salary slips" 
                   Foreground="#94A3B8" FontStyle="Italic" Margin="0,10,0,0"/>
    </Grid>
</UserControl>
