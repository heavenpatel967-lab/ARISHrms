<UserControl x:Class="ARISHrms.Views.MonthlyLeaveTable"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Minimal last-6-months leave summary: one line per month -->
    <StackPanel>
        <DockPanel LastChildFill="False" Margin="0,0,0,4">
            <TextBlock x:Name="TxtTitle" Text="Leaves - last 6 months" FontWeight="SemiBold" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/>
            <Button x:Name="BtnEdit" DockPanel.Dock="Right" Content="✏️ Edit" Click="BtnEdit_Click" Padding="8,1" FontSize="11"
                    Background="#EFF6FF" BorderBrush="#BFDBFE" Foreground="#1D4ED8" Cursor="Hand" ToolTip="Change informed / without informing"/>
        </DockPanel>

        <!-- header -->
        <Grid Margin="0,0,0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="70"/>
                <ColumnDefinition Width="110"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Month" FontSize="10" Foreground="#94A3B8"/>
            <TextBlock Grid.Column="1" Text="Informed" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="Without informing" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
        </Grid>

        <ItemsControl x:Name="IcMonths">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#F1F5F9" BorderThickness="0,1,0,0" Padding="0,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="110"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" FontSize="12" Foreground="#0F172A"/>
                            <TextBlock Grid.Column="1" Text="{Binding InformedText}" FontSize="12" FontWeight="Bold" Foreground="{Binding InformedColor}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding UninformedText}" FontSize="12" FontWeight="Bold" Foreground="{Binding UninformedColor}" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock x:Name="TxtSource" FontSize="10" Foreground="#94A3B8" Margin="0,3,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
