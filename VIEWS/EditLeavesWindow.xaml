<Window x:Class="ARISHrms.Views.EditLeavesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Leaves - Informed / Without informing" Height="560" Width="600"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtEmployee" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Text="Absent days count as Informed unless you mark them Without informing." Foreground="#64748B" FontSize="11" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- month picker -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="False">
            <Button Content="◀" Click="BtnPrev_Click" Width="32" Height="28" ToolTip="Previous month"/>
            <TextBlock x:Name="TxtMonth" FontSize="14" FontWeight="Bold" Width="120" TextAlignment="Center" VerticalAlignment="Center"/>
            <Button Content="▶" Click="BtnNext_Click" Width="32" Height="28" ToolTip="Next month"/>
            <TextBlock x:Name="TxtMonthTotals" DockPanel.Dock="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
        </DockPanel>

        <DataGrid Grid.Row="2" x:Name="DaysGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                  BorderBrush="#E2E8F0" RowHeight="30" Background="White">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="110"/>
                <DataGridTextColumn Header="From" Binding="{Binding SourceLabel}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Leave type" Width="240">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton Content="Informed" IsChecked="{Binding Informed, Mode=OneWay}" Click="RbInformed_Click"
                                             GroupName="{Binding DateDisplay}" Foreground="#27AE60" FontWeight="Bold" Margin="0,0,14,0"/>
                                <RadioButton Content="Without informing" IsChecked="{Binding Uninformed, Mode=OneWay}" Click="RbUninformed_Click"
                                             GroupName="{Binding DateDisplay}" Foreground="#E74C3C" FontWeight="Bold"/>
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="" Width="*">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button Content="✕" Click="BtnRemove_Click" Visibility="{Binding RemoveVisibility}" ToolTip="Remove this hand-added date"
                                    Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Cursor="Hand" HorizontalAlignment="Right" Padding="6,0"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="2" x:Name="TxtEmpty" Text="No leave days in this month." Foreground="#94A3B8" FontStyle="Italic"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <!-- add a date -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,10,0,0">
            <WrapPanel>
                <TextBlock Text="Add a leave date:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,8,0"/>
                <DatePicker x:Name="DpAdd" Width="130" Height="28" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbAddKind" Width="160" Height="28" SelectedIndex="1" Margin="0,0,8,0" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Informed"/>
                    <ComboBoxItem Content="Without informing"/>
                </ComboBox>
                <Button Content="➕ Add" Click="BtnAdd_Click" Width="70" Height="28" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
            </WrapPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="TxtSource" DockPanel.Dock="Left" Foreground="#94A3B8" FontSize="10" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="BtnClose_Click" Width="90" Height="30" IsCancel="True"/>
        </DockPanel>
    </Grid>
</Window>
