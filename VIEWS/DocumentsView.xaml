<UserControl x:Class="ARISHrms.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Employee Selection -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="False">
            <TextBlock Text="Employee Document Repository" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Select Employee:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbSelectEmployee" Width="250" Height="32" VerticalContentAlignment="Center" 
                          DisplayMemberPath="FullName" SelectedValuePath="EmpCode" SelectionChanged="CmbSelectEmployee_SelectionChanged"/>
            </StackPanel>
        </DockPanel>

        <!-- Upload New Document Form -->
        <GroupBox Grid.Row="1" Header="Upload New Document" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Category -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Category:" VerticalAlignment="Center" FontWeight="Normal" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbDocCategory" Grid.Row="0" Grid.Column="1" Height="28" VerticalContentAlignment="Center">
                    <ComboBoxItem Content="Aadhar Card" IsSelected="True"/>
                    <ComboBoxItem Content="PAN Card"/>
                    <ComboBoxItem Content="Bank Passbook / Cheque"/>
                    <ComboBoxItem Content="Passport Photo"/>
                    <ComboBoxItem Content="Joining Letter"/>
                    <ComboBoxItem Content="Other"/>
                </ComboBox>

                <!-- Document Name / Alias -->
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Document Name:" VerticalAlignment="Center" FontWeight="Normal" Margin="20,0,10,0"/>
                <TextBox x:Name="TxtDocName" Grid.Row="0" Grid.Column="3" Height="28" VerticalContentAlignment="Center" Padding="5,0"/>

                <!-- Browse File -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <Button Content="📂 Browse File" Click="BtnBrowse_Click" Width="120" Height="28" Background="#E2E8F0" Foreground="#0F172A" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtSelectedFilePath" Text="No file selected..." VerticalAlignment="Center" Margin="10,0,0,0" Foreground="#64748B" FontStyle="Italic"/>
                </StackPanel>

                <!-- Save Button -->
                <Button Grid.Row="2" Grid.Column="4" Content="💾 Save Document" Click="BtnSaveDocument_Click" Width="150" Height="32" Background="#2563EB" Foreground="White" FontWeight="Bold"/>
            </Grid>
        </GroupBox>

        <!-- Uploaded Documents Grid -->
        <GroupBox Grid.Row="2" Header="Uploaded Documents" FontWeight="Bold" Foreground="#0F172A">
            <DataGrid x:Name="DocumentsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      Background="White" RowHeight="32" AlternatingRowBackground="#F8FAFC" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Upload Date" Binding="{Binding UploadDate, StringFormat=dd-MM-yyyy HH:mm}" Width="150"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding DocCategory}" Width="150"/>
                    <DataGridTextColumn Header="Document Name" Binding="{Binding DocName}" Width="*"/>

                    <DataGridTemplateColumn Header="Action" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="👁️ View" Click="BtnViewDocument_Click" Background="#38BDF8" Foreground="White" Padding="8,2" BorderThickness="0" Margin="0,0,5,0" Cursor="Hand"/>
                                    <Button Content="🗑️ Delete" Click="BtnDeleteDocument_Click" Background="#EF4444" Foreground="White" Padding="8,2" BorderThickness="0" Cursor="Hand"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>
    </Grid>
</UserControl>