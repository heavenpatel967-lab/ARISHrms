<Window x:Class="ARISHrms.Views.MonthlyAttendanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Monthly Attendance Summary" Height="760" Width="1120" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F8FAFC">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- employee + month -->
        <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
            <TextBlock Text="🔍 Card No / Name:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSearch" Width="140" Height="30" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,6,0"
                     ToolTip="Type a card number, employee code or name. Enter = pick the best match, Down arrow = open the list, Esc = clear."/>
            <TextBlock x:Name="TxtSearchHint" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" MinWidth="70" Margin="0,0,8,0"/>
            <ComboBox x:Name="CmbEmployee" Width="320" Height="30" VerticalContentAlignment="Center"
                      DisplayMemberPath="DisplayName" SelectionChanged="CmbEmployee_SelectionChanged"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="◀" Click="BtnPrev_Click" Width="32" Height="30" ToolTip="Previous month"/>
                <TextBlock x:Name="TxtMonth" FontSize="15" FontWeight="Bold" Width="130" TextAlignment="Center" VerticalAlignment="Center" Foreground="#0F172A"/>
                <Button Content="▶" Click="BtnNext_Click" Width="32" Height="30" ToolTip="Next month"/>
            </StackPanel>
        </DockPanel>

        <!-- options -->
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBlock x:Name="TxtShift" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,18,0"/>
            <TextBlock Text="Week off:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbWeekOff" Width="120" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbWeekOff_SelectionChanged"/>
            <TextBlock x:Name="TxtWeekOffSource" VerticalAlignment="Center" Foreground="#94A3B8" FontSize="11" Margin="6,0,18,0"/>
            <TextBlock Text="Overtime:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
            <ComboBox x:Name="CmbRounding" Width="190" Height="28" VerticalContentAlignment="Center" SelectionChanged="CmbRounding_SelectionChanged">
                <ComboBoxItem Content="Exact minutes"/>
                <ComboBoxItem Content="Round down to 15 min"/>
                <ComboBoxItem Content="Round down to 30 min"/>
            </ComboBox>
        </WrapPanel>

        <!-- summary cards (filled in code) -->
        <WrapPanel Grid.Row="2" x:Name="CardsPanel" Margin="0,0,0,6"/>

        <TextBlock Grid.Row="3" x:Name="TxtRules" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- day by day -->
        <DataGrid Grid.Row="4" x:Name="DaysGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                  HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                  BorderBrush="#E2E8F0" RowHeight="26" Background="White" CanUserSortColumns="False">
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="Absent">
                            <Setter Property="Background" Value="#FEF2F2"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Week off">
                            <Setter Property="Background" Value="#F5F3FF"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Status}" Value="Worked on week off">
                            <Setter Property="Background" Value="#ECFEFF"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding DateDisplay}" Width="125"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="165">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding StatusColor}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="In" Binding="{Binding In}" Width="60"/>
                <DataGridTextColumn Header="L-Out" Binding="{Binding LOut}" Width="60"/>
                <DataGridTextColumn Header="L-In" Binding="{Binding LIn}" Width="60"/>
                <DataGridTextColumn Header="Out" Binding="{Binding Out}" Width="60"/>
                <DataGridTextColumn Header="Extra" Binding="{Binding Extra}" Width="90"/>
                <DataGridTextColumn Header="Worked" Binding="{Binding WorkedDisplay}" Width="70"/>
                <DataGridTextColumn Header="Late" Binding="{Binding LateDisplay}" Width="65">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#D97706"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Early out" Binding="{Binding EarlyDisplay}" Width="70"/>
                <DataGridTextColumn Header="OT" Binding="{Binding OtDisplay}" Width="60">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="#0E7490"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- footer -->
        <DockPanel Grid.Row="5" Margin="0,10,0,0" LastChildFill="False">
            <TextBlock x:Name="TxtDataRange" DockPanel.Dock="Left" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="640"/>
            <Button DockPanel.Dock="Right" Content="Close" Click="BtnClose_Click" Width="80" Height="30" IsCancel="True"/>
            <Button DockPanel.Dock="Right" Content="🖨️ Print" Click="BtnPrint_Click" Width="90" Height="30" Margin="0,0,8,0" Background="#0F172A" Foreground="White" FontWeight="Bold"/>
            <Button DockPanel.Dock="Right" Content="📊 Export Excel" Click="BtnExport_Click" Width="120" Height="30" Margin="0,0,8,0" Background="#10B981" Foreground="White" FontWeight="Bold"/>
        </DockPanel>
    </Grid>
</Window>
