<Window x:Class="ARISHrms.Views.BatchEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Edit Punches" Height="480" Width="360" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Enter new times in HH:mm format:" FontWeight="Bold" Margin="0,0,0,5"/>

        <!-- 🔥 NEW: The Checkbox that controls the logic -->
        <CheckBox x:Name="chkKeepBlank" Grid.Row="1" Content="If a box is blank, KEEP the original punch" IsChecked="True" Foreground="#C0392B" FontWeight="Bold" Margin="0,0,0,15"/>

        <DockPanel Grid.Row="2" Margin="0,5">
            <TextBlock Text="In Time:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtIn" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,5">
            <TextBlock Text="L-Out Time:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtLOut" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Grid.Row="4" Margin="0,5">
            <TextBlock Text="L-In Time:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtLIn" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Grid.Row="5" Margin="0,5">
            <TextBlock Text="Out Time:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtOut" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Grid.Row="6" Margin="0,5">
            <TextBlock Text="Punch 5:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtP5" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Grid.Row="7" Margin="0,5">
            <TextBlock Text="Punch 6:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtP6" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Grid.Row="8" Margin="0,5">
            <TextBlock Text="Punch 7:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtP7" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <DockPanel Grid.Row="9" Margin="0,5">
            <TextBlock Text="Punch 8:" Width="80" VerticalAlignment="Center"/>
            <TextBox x:Name="txtP8" Width="100" HorizontalAlignment="Left"/>
        </DockPanel>

        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Button Content="Apply to Selected" Width="120" Height="30" Background="#F39C12" Foreground="White" FontWeight="Bold" Click="BtnApply_Click" Margin="0,0,10,0"/>
            <Button Content="Cancel" Width="80" Height="30" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>