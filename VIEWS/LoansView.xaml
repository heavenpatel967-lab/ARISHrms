<UserControl x:Class="ARISHrms.Views.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ARISHrms.Views"
             Background="#F8FAFC">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Employee Selection -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="False">
            <TextBlock Text="Employee Loan Ledger" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

            <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="🔍 Card No / Name:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtEmpSearch" Width="150" Height="32" VerticalContentAlignment="Center" Padding="6,0" Margin="0,0,6,0"
                         ToolTip="Type a card number, employee code or name. Enter = pick the best match, Down arrow = open the list, Esc = clear."/>
                <TextBlock x:Name="TxtSearchHint" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" MinWidth="95" Margin="0,0,14,0"/>
                <TextBlock Text="Select Employee:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbSelectEmployee" Width="330" Height="32" VerticalContentAlignment="Center" 
                          DisplayMemberPath="DisplayName" SelectedValuePath="EmpCode" SelectionChanged="CmbSelectEmployee_SelectionChanged"/>
            </WrapPanel>
        </DockPanel>

        <!-- Summary KPI Cards -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Approved -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Loan Given" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalApproved" Text="₹ 0.00" Foreground="White" FontWeight="Bold" FontSize="24" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- EMI Deducted -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Recovered So Far" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalEmi" Text="₹ 0.00" Foreground="White" FontWeight="Bold" FontSize="24" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Outstanding -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Current Outstanding Loan" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtOutstanding" Text="₹ 0.00" Foreground="#EF4444" FontWeight="Bold" FontSize="24" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Repayment Health -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Repayment Health" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtHealth" Text="0 / 0 Paid" Foreground="#38BDF8" FontWeight="Bold" FontSize="18" Margin="0,5,0,0"/>
                    <StackPanel x:Name="HealthBarContainer" Orientation="Horizontal" Margin="0,5,0,0" Height="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Monthly Timeline Grid -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>
            <GroupBox Grid.Column="0" Header="Monthly Loan &amp; Deduction Timeline" FontWeight="Bold" Foreground="#0F172A">
                <DataGrid x:Name="LoanGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                          Background="White" RowHeight="32" AlternatingRowBackground="#F8FAFC" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Month / Year" Binding="{Binding MonthYear}" Width="150"/>
                        <DataGridTextColumn Header="Pending Loan Amount" Binding="{Binding PendingLoanAmount, TargetNullValue='-', StringFormat=₹ {0:N2}}" Width="250"/>
                        <DataGridTextColumn Header="EMI Deducted" Binding="{Binding EmiDeducted, TargetNullValue='-', StringFormat=₹ {0:N2}}" Width="200">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <local:TrackRecordPanel x:Name="TrackRecord" Grid.Column="2"/>
        </Grid>

        <!-- Footer Actions -->
        <DockPanel Grid.Row="3" Margin="0,15,0,0" LastChildFill="False">
        <TextBlock x:Name="TxtInfo" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="#475569" FontWeight="SemiBold" Text=""/>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
            <Button Content="📊 Export to Excel" Click="BtnExportExcel_Click" Width="130" Height="34" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="📄 Save as PDF" Click="BtnSavePdf_Click" Width="130" Height="34" Background="#EF4444" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
        </DockPanel>
    </Grid>
</UserControl>