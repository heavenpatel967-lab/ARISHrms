<UserControl x:Class="ARISHrms.Views.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">
    <Grid Margin="0,10,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Employee Selection -->
        <DockPanel Grid.Row="0" Margin="0,0,0,15" LastChildFill="False">
            <TextBlock Text="Employee Loan Ledger" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="Select Employee:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,10,0"/>
                <ComboBox x:Name="CmbSelectEmployee" Width="250" Height="32" VerticalContentAlignment="Center" 
                          DisplayMemberPath="FullName" SelectedValuePath="EmpCode" SelectionChanged="CmbSelectEmployee_SelectionChanged"/>
            </StackPanel>
        </DockPanel>

        <!-- Summary KPI Cards -->
        <Border Grid.Row="1" Background="#1E293B" CornerRadius="8" Padding="20" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Total Approved -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Total Loan Approved" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalApproved" Text="₹ 0.00" Foreground="White" FontWeight="Bold" FontSize="24" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- EMI Deducted -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Total EMI Deducted" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtTotalEmi" Text="₹ 0.00" Foreground="White" FontWeight="Bold" FontSize="24" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Outstanding -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Current Outstanding Loan" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtOutstanding" Text="₹ 0.00" Foreground="#EF4444" FontWeight="Bold" FontSize="24" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Repayment Health -->
                <StackPanel Grid.Column="3">
                    <TextBlock Text="Repayment Health" Foreground="#94A3B8" FontWeight="SemiBold" FontSize="12"/>
                    <TextBlock x:Name="TxtHealth" Text="0 / 0 Paid" Foreground="#38BDF8" FontWeight="Bold" FontSize="18" Margin="0,5,0,0"/>
                    <StackPanel x:Name="HealthBarContainer" Orientation="Horizontal" Margin="0,5,0,0" Height="10"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Monthly Timeline Grid -->
        <GroupBox Grid.Row="2" Header="Monthly Loan &amp; Deduction Timeline" FontWeight="Bold" Foreground="#0F172A">
            <DataGrid x:Name="LoanGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True"
                      Background="White" RowHeight="32" AlternatingRowBackground="#F8FAFC" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0" BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Month / Year" Binding="{Binding MonthYear}" Width="150"/>
                    <DataGridTextColumn Header="Pending Loan Amount" Binding="{Binding OutstandingBalance, StringFormat=₹ {0:N2}}" Width="250"/>
                    <DataGridTextColumn Header="EMI Deducted" Binding="{Binding EmiDeducted, TargetNullValue='-', StringFormat=₹ {0:N2}}" Width="200">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#EF4444"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </GroupBox>

        <!-- Footer Actions -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="Amount (₹):" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtLoanAmount" Width="90" Height="34" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,12,0"/>
            <TextBlock Text="Months:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtLoanTenure" Width="50" Height="34" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,12,0"/>
            <TextBlock Text="Rate % p.a.:" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,6,0"/>
            <TextBox x:Name="TxtLoanRate" Text="0" Width="50" Height="34" VerticalContentAlignment="Center" Padding="5,0" Margin="0,0,12,0"/>
            <Button Content="➕ Create Loan" Click="BtnCreateLoan_Click" Width="120" Height="34" Background="#2563EB" Foreground="White" FontWeight="Bold" Margin="0,0,20,0"/>
            <Button Content="📊 Export to Excel" Click="BtnExportExcel_Click" Width="130" Height="34" Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
            <Button Content="📄 Save as PDF" Click="BtnSavePdf_Click" Width="130" Height="34" Background="#EF4444" Foreground="White" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</UserControl>