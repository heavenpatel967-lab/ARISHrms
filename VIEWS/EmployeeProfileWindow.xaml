<Window x:Class="ARISHrms.Views.EmployeeProfileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ARISHrms.Views"
        Title="360° Employee Summary" Height="900" Width="950"
        WindowStartupLocation="CenterOwner" Background="#E5E5E5">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="White" Padding="15" BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="✏️ Edit Details" Click="BtnEdit_Click" Width="130" Height="35" Background="#F59E0B" Foreground="White" FontWeight="Bold" Margin="0,0,10,0"/>
                <Button Content="🖨️ Print / Save as PDF (all pages)" Click="BtnPrint_Click" Width="230" Height="35" Background="#0078D7" Foreground="White" FontWeight="Bold"/>
                <Button Content="Close" Click="BtnClose_Click" Width="100" Height="35" Margin="10,0,0,0"/>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="20">
            <Grid x:Name="PrintArea" Width="794" MinHeight="1123" Background="White" Margin="0,0,0,20">
                <Grid.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.1" BlurRadius="10" ShadowDepth="2"/>
                </Grid.Effect>

                <StackPanel Margin="40">
                    <TextBlock Text="ARIS BATHWARES &amp; SANITARYWARES" FontSize="26" FontWeight="Black" HorizontalAlignment="Center"/>
                    <TextBlock Text="360° EMPLOYEE SUMMARY REPORT" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,20" Foreground="#555555"/>
                    <Rectangle Height="2" Fill="#000000" Margin="0,0,0,20"/>

                    <TextBlock Text="PERSONAL &amp; CAREER DETAILS" FontWeight="Bold" FontSize="16" Foreground="#0078D7" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,20,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                            <RowDefinition Height="25"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Employee Name:" FontWeight="SemiBold" Grid.Row="0"/>
                        <TextBlock x:Name="TxtFullName" Grid.Row="0" Grid.Column="1" FontWeight="Bold"/>

                        <TextBlock Text="Emp Code / Card No:" FontWeight="SemiBold" Grid.Row="1"/>
                        <TextBlock x:Name="TxtCodes" Grid.Row="1" Grid.Column="1"/>

                        <TextBlock Text="Department:" FontWeight="SemiBold" Grid.Row="2"/>
                        <TextBlock x:Name="TxtDept" Grid.Row="2" Grid.Column="1"/>

                        <TextBlock Text="Phone Number:" FontWeight="SemiBold" Grid.Row="3"/>
                        <TextBlock x:Name="TxtPhone" Grid.Row="3" Grid.Column="1"/>

                        <TextBlock Text="Aadhar Number:" FontWeight="SemiBold" Grid.Row="4"/>
                        <TextBlock x:Name="TxtAadhar" Grid.Row="4" Grid.Column="1"/>

                        <TextBlock Text="Native Village:" FontWeight="SemiBold" Grid.Row="5"/>
                        <TextBlock x:Name="TxtVillage" Grid.Row="5" Grid.Column="1"/>

                        <TextBlock Text="Status:" FontWeight="SemiBold" Grid.Row="6"/>
                        <TextBlock x:Name="TxtStatus" Grid.Row="6" Grid.Column="1" FontWeight="Bold"/>
                    </Grid>

                    <Rectangle Height="1" Fill="#DDDDDD" Margin="0,0,0,20"/>

                    <TextBlock Text="FINANCIAL SUMMARY" FontWeight="Bold" FontSize="16" Foreground="#0078D7" Margin="0,0,0,10"/>
                    <Grid Margin="0,0,0,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30"/>
                            <RowDefinition Height="30"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Total Outstanding Loan:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0"/>
                        <TextBlock x:Name="TxtTotalLoan" Text="-" FontWeight="Bold" FontSize="13" Foreground="#C0392B" VerticalAlignment="Center" Grid.Row="0" Grid.Column="1"/>

                        <StackPanel Grid.Column="2" Grid.RowSpan="2" VerticalAlignment="Center" Margin="5,0,5,0">
                            <TextBlock Text="Loan Health:" Foreground="#555555" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtLoanHealth" Text="-" Foreground="#333333" FontSize="13" FontWeight="Bold" Margin="0,1,0,0"/>
                            <ItemsControl x:Name="IcLoanDots" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="10" Height="10" Background="{Binding Color}" CornerRadius="2" Margin="0,0,2,0" ToolTip="{Binding Month}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <TextBlock Text="Total Advance Taken:" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0"/>
                        <TextBlock x:Name="TxtTotalAdvance" Text="-" FontWeight="Bold" FontSize="13" Foreground="#E67E22" VerticalAlignment="Center" Grid.Row="1" Grid.Column="1"/>

                        <StackPanel Grid.Column="3" Grid.RowSpan="2" VerticalAlignment="Center" Margin="5,0,5,0">
                            <TextBlock Text="Advance Health:" Foreground="#555555" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtAdvanceHealth" Text="-" Foreground="#333333" FontSize="13" FontWeight="Bold" Margin="0,1,0,0"/>
                            <ItemsControl x:Name="IcAdvanceDots" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,2,0" ToolTip="{Binding Month}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="4" Grid.RowSpan="2" VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock Text="Leave Reliability:" Foreground="#555555" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtLeaveHealth" Text="-" Foreground="#333333" FontSize="13" FontWeight="Bold" Margin="0,1,0,0"/>
                            <ItemsControl x:Name="IcLeaveDots" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,2,0" ToolTip="{Binding Month}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="5" Grid.RowSpan="2" VerticalAlignment="Center" Margin="5,0,0,0">
                            <TextBlock Text="Advance Taken:" Foreground="#555555" FontSize="11" FontWeight="SemiBold"/>
                            <TextBlock x:Name="TxtTakenHealth" Text="-" Foreground="#333333" FontSize="13" FontWeight="Bold" Margin="0,1,0,0"/>
                            <ItemsControl x:Name="IcTakenDots" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="10" Height="10" Fill="{Binding Color}" Margin="0,0,2,0" ToolTip="{Binding Month}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>

                    <TextBlock x:Name="TxtLastAdvance" Foreground="#555555" FontSize="11" Margin="0,-22,0,18"/>

                    <TextBlock x:Name="TxtDataNote" Foreground="#C0392B" FontSize="11" Margin="0,-18,0,16" TextWrapping="Wrap"/>

                    <Rectangle Height="1" Fill="#DDDDDD" Margin="0,0,0,20"/>

                    <TextBlock Text="REMARKS &amp; TRACK RECORD" FontWeight="Bold" FontSize="16" Foreground="#0078D7" Margin="0,0,0,10"/>
                    <local:TrackRecordPanel x:Name="TrackRecord" Margin="0,0,0,20"/>

                    <Rectangle Height="1" Fill="#DDDDDD" Margin="0,0,0,20"/>

                    <DockPanel Margin="0,0,0,10" LastChildFill="False">
                        <TextBlock Text="VILLAGE VISIT / LONG LEAVE HISTORY" FontWeight="Bold" FontSize="16" Foreground="#0078D7"/>
                        <TextBlock x:Name="TxtLeaveCount" DockPanel.Dock="Right" Foreground="#64748B" VerticalAlignment="Center"/>
                    </DockPanel>
                    <DataGrid x:Name="LeaveGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" Background="White" BorderBrush="#CCCCCC"
                              HeadersVisibility="Column" HorizontalGridLinesBrush="#EEEEEE" VerticalGridLinesBrush="Transparent">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Departure" Binding="{Binding DepartureDate, StringFormat=dd-MM-yyyy}" Width="110"/>
                            <DataGridTextColumn Header="Expected Return" Binding="{Binding ExpectedReturn, StringFormat=dd-MM-yyyy}" Width="130"/>
                            <DataGridTextColumn Header="Actual Return" Binding="{Binding ActualReturn, StringFormat=dd-MM-yyyy, TargetNullValue='Pending'}" Width="120"/>
                            <DataGridTextColumn Header="Late Days" Binding="{Binding LateDays}" Width="90"/>
                            <DataGridTextColumn Header="Reason / Notes" Binding="{Binding ReasonNotes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Generated by ARIS HRMS" FontSize="10" Foreground="Gray" HorizontalAlignment="Right" Margin="0,40,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
